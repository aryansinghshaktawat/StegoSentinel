# ==============================================================================
# StegoSentinel Environment Configuration
# ==============================================================================

# System Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# API Gateway Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Authentication & Security
JWT_SECRET_KEY=dev-insecure-secret-key-change-in-prod-32bytes!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration (Defaults to local SQLite for instant dev; PostgreSQL in prod)
DATABASE_URL=sqlite:///./stegosentinel.db
# For PostgreSQL: postgresql://stego_user:stego_password@localhost:5432/stegosentinel

# Job Queue & Asynchronous Processing
# Options: "thread" (in-process for zero-config dev/tests), "redis" (production worker)
ASYNC_MODE=thread
REDIS_URL=redis://localhost:6379/0

# Storage Quarantine Configuration
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage/quarantine
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=stegosentinel-quarantine

# Resource & Forensic Limits (Hard Budgets)
MAX_UPLOAD_SIZE=104857600           # 100 MB
MAX_FILE_SIZE_PER_OBJECT=52428800   # 50 MB
MAX_TOTAL_EXTRACTED_SIZE=262144000  # 250 MB
MAX_RECURSION_DEPTH=3
MAX_EXTRACTED_OBJECTS=20
MAX_ANALYSIS_SECONDS=60
MAX_CANDIDATES=1000

# AI / ML & Explanation Configuration
ML_MODEL_PATH=./ml/models/stego_ranker.pkl
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
