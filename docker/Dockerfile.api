# StegoSentinel API Gateway Dockerfile
FROM python:3.11-slim as base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8000

WORKDIR /app

# Install security updates and curl for healthcheck
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install uv package manager
COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv

# Copy project definition and install dependencies
COPY backend/pyproject.toml backend/README.md /app/
RUN uv venv /app/.venv && uv pip install --no-cache -r <(uv pip compile /app/pyproject.toml)

# Copy application source code
COPY backend/app /app/app

# Non-root unprivileged execution
RUN useradd -u 10001 -m stegouser && \
    mkdir -p /app/storage/quarantine && \
    chown -R stegouser:stegouser /app

USER stegouser

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:8000/api/v1/health || exit 1

CMD ["/app/.venv/bin/uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
